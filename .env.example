# Copy this file to .env.local and fill in real values there. .env.local (and any
# other .env* file) is gitignored — never commit real secrets.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Server-only secrets (read by server/api.ts, never bundled into the client) ---
#
# SESSION_SECRET: required on any host that runs more than one server instance
# (Vercel serverless functions included — every request may hit a different
# instance). Sessions are signed tokens verified with this secret; if it isn't
# set, each instance/cold start makes up its own random one, which makes login
# appear to work and then immediately bounce back to the login screen. Set it
# to any long random string and keep it the same across all instances/deploys.
SESSION_SECRET=""

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: optional cloud backup/sync for the
# central server. The browser never talks to Supabase directly and never receives
# these values. Get them from your Supabase project settings -> API.
# The service_role key bypasses Row Level Security — keep it secret, server-side only.
# On serverless hosts (Vercel), this is also the ONLY durable storage: the local
# data/database.json file does not persist between requests there, so without
# these two set, people/schedules/etc. would be lost after every cold start.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ADMIN_BOOTSTRAP_EMAIL / ADMIN_BOOTSTRAP_PASSWORD: optional. Used only the first
# time the server starts (when data/database.json does not exist yet) to create the
# initial "admin" account. If ADMIN_BOOTSTRAP_PASSWORD is left empty, the server
# generates a random secure password and prints it once to the server console —
# save it immediately, it is not stored anywhere in plaintext.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
